WECHAT_VIRTUAL_PAY_OFFER_ID=1450546075
# 沙箱环境 AppKey（env=1 时使用）
WECHAT_VIRTUAL_PAY_APPKEY_SANDBOX=xpwIcJWKhDhTxHdaa3NZ4cS8jy4BwdiW
# 现网环境 AppKey（env=0 时使用）
WECHAT_VIRTUAL_PAY_APPKEY_PRODUCTION=PeXursiQ0PArqnPRW25Kp95w6tniuurz
# 支付环境：1=沙箱（测试用），0=现网（正式上线）
WECHAT_VIRTUAL_PAY_ENV=1
