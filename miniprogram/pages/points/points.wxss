.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 60rpx; }

/* === 骨架屏 === */
.skeleton-card {
  background: #fff;
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
}
.skeleton-card.h-120 { height: 160rpx; }
.skeleton-line {
  height: 22rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e5e5e5 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
.skeleton-line:last-child { margin-bottom: 0; }
.w-25 { width: 25%; }
.w-40 { width: 40%; }
.w-60 { width: 60%; }
.w-80 { width: 80%; }
.sk-row { display: flex; align-items: center; gap: 20rpx; }
.sk-avatar {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  animation: shimmer 1.5s infinite;
  background-size: 200% 100%;
}
.sk-col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 用户卡 */
.user-card {
  background: #fff;
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.user-avatar {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a56db, #2563eb);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.user-info { flex: 1; }
.user-phone { font-size: 28rpx; color: #333; }
.phone-bound { font-size: 24rpx; color: #10b981; }
.btn-phone {
  margin-top: 12rpx;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  background: #1a56db;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  line-height: 1;
}

.balance-card {
  background: linear-gradient(135deg, #1a56db, #2563eb);
  margin: 24rpx;
  padding: 40rpx;
  border-radius: 20rpx;
  text-align: center;
}
.balance-label { font-size: 26rpx; color: rgba(255,255,255,0.7); }
.balance-num { display: block; font-size: 64rpx; font-weight: 700; color: #fff; margin-top: 12rpx; }

.section-title { font-size: 28rpx; font-weight: 600; padding: 24rpx 24rpx 12rpx; }

/* 套餐卡片 */
.pkg-card {
  background: #fff;
  margin: 0 24rpx 12rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2px solid transparent;
  transition: border-color 0.2s;
}
.pkg-card.selected {
  border-color: #1a56db;
  background: #f0f5ff;
}
.pkg-points { display: block; font-size: 30rpx; font-weight: 600; }
.pkg-price { font-size: 28rpx; color: #1a56db; margin-top: 4rpx; font-weight: 600; }
.pkg-per { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
.pkg-check {
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  border: 2px solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
}
.pkg-check.checked {
  background: #1a56db;
  border-color: #1a56db;
}

/* 积分明细 */
.tx-card {
  background: #fff;
  margin: 0 24rpx 8rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 12rpx;
}
.tx-left { flex: 1; min-width: 0; }
.tx-desc { font-size: 26rpx; color: #333; display: block; }
.tx-time { font-size: 22rpx; color: #999; margin-top: 6rpx; display: block; }
.tx-amount { font-size: 30rpx; font-weight: 600; flex-shrink: 0; margin-left: 20rpx; }
.tx-amount.positive { color: #10b981; }
.tx-amount.negative { color: #ef4444; }

/* 使用说明 */
.tips {
  background: #fff;
  margin: 32rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.tips-title { display: block; font-size: 26rpx; font-weight: 600; margin-bottom: 12rpx; }
.tips text { display: block; font-size: 24rpx; color: #999; line-height: 1.8; }

/* 支付中 */
.pkg-card.paying { opacity: 0.7; pointer-events: none; }
.paying-dot {
  width: 24rpx; height: 24rpx;
  border-radius: 50%;
  background: #1a56db;
  animation: pulse 1s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
.pay-hint {
  text-align: center;
  padding: 24rpx;
  color: #1a56db;
  font-size: 26rpx;
}
