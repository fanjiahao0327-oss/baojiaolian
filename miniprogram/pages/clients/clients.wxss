.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 40rpx; }

/* === 骨架屏 === */
.skeleton-card {
  background: #fff;
  padding: 28rpx 24rpx;
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
}
.skeleton-line {
  height: 22rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e5e5e5 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
.skeleton-line:last-child { margin-bottom: 0; }
.w-50 { width: 50%; }
.w-30 { width: 30%; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* === 搜索栏 === */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 20rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
}
.search-icon { font-size: 28rpx; color: #999; flex-shrink: 0; }
.search-input { flex: 1; font-size: 28rpx; }
.search-clear { font-size: 28rpx; color: #ccc; padding: 4rpx 12rpx; flex-shrink: 0; }

/* === 列表 === */
.client-card {
  background: #fff;
  padding: 24rpx;
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.c-left { flex: 1; min-width: 0; }
.c-name { font-size: 30rpx; font-weight: 500; display: block; }
.c-tags { display: flex; gap: 10rpx; margin-top: 10rpx; flex-wrap: wrap; }
.c-tag {
  font-size: 22rpx;
  color: #1a56db;
  background: #e8f0fe;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.c-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; flex-shrink: 0; }
.c-time { font-size: 22rpx; color: #999; }
.c-arrow { font-size: 24rpx; color: #ccc; }

/* 空状态 */
.empty {
  display: flex; flex-direction: column; align-items: center;
  padding: 140rpx 40rpx; color: #999;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-sub { font-size: 24rpx; color: #ccc; margin-top: 12rpx; }

/* 详情头部 */
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1px solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.back-btn { font-size: 28rpx; color: #1a56db; padding: 8rpx 0; }
.header-actions { display: flex; gap: 16rpx; }
.sm { padding: 12rpx 24rpx; font-size: 24rpx; border-radius: 12rpx; }
.d-name { padding: 24rpx 32rpx; font-size: 34rpx; font-weight: 700; background: #fff; }

/* KYC 区块 */
.kyc-section { background: #fff; margin: 16rpx 20rpx; border-radius: 16rpx; overflow: hidden; }
.s-header {
  display: flex; align-items: center; gap: 12rpx;
  padding: 20rpx 24rpx; background: #f9fafb;
}
.s-arrow { font-size: 20rpx; color: #999; width: 24rpx; }
.s-title { font-size: 28rpx; font-weight: 600; }
.s-body { padding: 16rpx 24rpx 24rpx; }

/* 展示模式 */
.kv-row {
  display: flex; padding: 14rpx 0;
  border-bottom: 1px solid #f5f5f5;
  align-items: flex-start;
}
.kv-row:last-child { border-bottom: none; }
.kv-label { width: 180rpx; font-size: 26rpx; color: #999; flex-shrink: 0; }
.kv-value-wrap { flex: 1; min-width: 0; }
.kv-value { font-size: 26rpx; color: #333; word-break: break-all; }
.kv-value.truncated {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}
.expand-link {
  font-size: 24rpx;
  color: #1a56db;
  margin-top: 4rpx;
  display: inline-block;
}

/* 编辑模式 */
.field { margin-bottom: 20rpx; }
.field:last-child { margin-bottom: 0; }
.field .label { font-size: 28rpx; color: #666; margin-bottom: 12rpx; display: block; }
.field .textarea {
  width: 100%;
  padding: 20rpx 16rpx;
  border: 1px solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #f9fafb;
  box-sizing: border-box;
  min-height: 100rpx;
}
.field .input {
  width: 100%; height: 80rpx; line-height: 80rpx;
  padding: 0 16rpx;
  border: 1px solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #f9fafb;
  box-sizing: border-box;
}
