<view class="page">
  <block wx:if="{{!done}}">
    <text class="title">预约一次一对一诊断</text>
    <text class="hint">留下称呼、手机号和方便时间，我会在 24 小时内联系你。</text>
    <input class="field" placeholder="怎么称呼你" maxlength="20" data-key="name" bindinput="onInput" />
    <input class="field" type="number" placeholder="手机号" maxlength="11" data-key="phone" bindinput="onInput" />
    <input class="field" placeholder="方便时间，例如：工作日晚 8 点后" maxlength="40" data-key="timeWindow" bindinput="onInput" />
    <textarea class="field textarea" placeholder="最想解决的一个问题（选填）" maxlength="200" data-key="question" bindinput="onInput" />
    <button class="primary" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交预约</button>
  </block>
  <block wx:else>
    <text class="title">已收到，24 小时内联系</text>
    <text class="hint">我会在 24 小时内联系你。也可以先通过小程序客服问我。</text>
    <button class="secondary" open-type="contact">联系客服</button>
  </block>
</view>
