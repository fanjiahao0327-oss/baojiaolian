<!-- 教练页 -->
<view class="page">

  <!-- 手机号绑定横幅（非阻塞，可关闭） -->
  <view class="phone-bind-banner" wx:if="{{isLoggedIn && needBindPhone && !hidePhoneBanner}}">
    <view class="banner-content">
      <text class="banner-icon">📱</text>
      <text class="banner-text">绑定手机号，解锁全部功能</text>
      <button class="banner-bind-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">去绑定</button>
      <text class="banner-close" bindtap="closePhoneBanner">✕</text>
    </view>
  </view>

  <!-- 顶部 Tab + 客户选择 -->
  <view class="top-bar">
    <view class="tabs">
      <view class="tab-item {{tab === 'form' ? 'active' : ''}}" data-tab="form" bindtap="switchTab">信息填写</view>
      <view class="tab-item {{tab === 'coach' ? 'active' : ''}}" data-tab="coach" bindtap="switchTab">教练指导</view>
    </view>
    <view class="top-right">
      <!-- 未登录：显示登录入口 -->
      <button wx:if="{{!isLoggedIn}}" class="login-entry-btn" bindtap="handleWechatLogin" loading="{{logining}}" disabled="{{logining}}">
        登录
      </button>
      <!-- 已登录：显示积分 -->
      <view class="balance-tag" wx:elif="{{balance >= 0}}" bindtap="goToPoints">
        <text class="balance-dot"></text>
        <text>{{balance}} 积分</text>
      </view>
      <view class="client-picker-btn" bindtap="toggleClientPicker" wx:if="{{isLoggedIn}}">
        <text>{{selectedClientId ? '已选客户' : '选择客户'}}</text>
        <text class="arrow">▾</text>
      </view>
    </view>
  </view>

  <!-- 客户选择弹出层 -->
  <view class="picker-overlay" wx:if="{{showClientPicker}}" bindtap="toggleClientPicker"></view>
  <view class="picker-popup {{showClientPicker ? 'show' : ''}}">
    <view class="picker-title">选择客户</view>
    <view class="picker-option" data-id="" bindtap="selectClient">+ 新建客户</view>
    <view class="picker-option" wx:for="{{clients}}" wx:key="id" data-id="{{item.id}}" bindtap="selectClient">{{item.name}}</view>
  </view>

  <!-- KYC 步骤式表单 -->
  <view class="form-area" wx:if="{{tab === 'form'}}">

    <!-- 快速模式切换 -->
    <view class="quick-mode-toggle" bindtap="toggleQuickMode">
      <view class="qmt-track {{quickMode ? 'active' : ''}}">
        <view class="qmt-thumb"></view>
      </view>
      <text class="qmt-label">{{quickMode ? '快速模式' : '完整模式'}}</text>
      <text class="qmt-desc">{{quickMode ? '10个核心字段，快速诊断' : '6步详细填写，深度诊断'}}</text>
    </view>

    <!-- 语音录入入口 -->
    <view class="voice-entry" wx:if="{{quickMode}}" bindtap="startVoiceInput">
      <text class="voice-icon">🎤</text>
      <text class="voice-label">语音快速录入</text>
      <text class="voice-hint">说出客户信息，AI 自动填表</text>
    </view>

    <!-- ====== 快速模式表单 ====== -->
    <view class="section" wx:if="{{quickMode}}">
      <view class="section-body">

        <view class="field">
          <view class="label">名称<text class="required">*</text></view>
          <input class="input" value="{{formData.clientName}}" data-key="clientName" bindinput="onFieldChange" placeholder="例如：张先生、李姐" />
        </view>

        <view class="field">
          <view class="label">年龄<text class="required">*</text></view>
          <input class="input" type="number" value="{{formData.age}}" data-key="age" bindinput="onFieldChange" placeholder="年龄决定生命周期定位" />
        </view>

        <view class="field">
          <view class="label">性别<text class="required">*</text></view>
          <view class="radio-group">
            <view class="radio-item {{formData.gender === 'male' ? 'checked' : ''}}" data-key="gender" data-val="male" bindtap="onFieldChange"><text>男</text></view>
            <view class="radio-item {{formData.gender === 'female' ? 'checked' : ''}}" data-key="gender" data-val="female" bindtap="onFieldChange"><text>女</text></view>
          </view>
        </view>

        <view class="field">
          <view class="label">行业</view>
          <picker mode="selector" range="{{['互联网/IT/通信','金融/保险/证券','教育/培训','医疗/健康/医药','制造业','汽车/机械','房地产/建筑/装修','零售/电商/贸易','餐饮/旅游/酒店','政府/事业单位/公务员','能源/电力/采矿/化工','物流/运输/交通','文化/传媒/广告','体育/健身/娱乐','农业/林业/渔业','法律/咨询/审计','科研/技术服务','家政/居民服务','水利/环境/公共设施','其他']}}" data-key="clientIndustry" bindchange="onSelectChange">
            <view class="picker-display">
              <text class="{{formData.clientIndustry ? '' : 'picker-placeholder'}}">{{formData.clientIndustry || '请选择行业'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>

        <view class="field">
          <view class="label">子女详情</view>
          <input class="input" value="{{formData.childrenDetail}}" data-key="childrenDetail" bindinput="onFieldChange" placeholder="例如：儿子/8岁/公立小学 / 无" />
        </view>

        <view class="field">
          <view class="label">家庭年收入（万元）</view>
          <input class="input" type="number" value="{{formData.annualIncome}}" data-key="annualIncome" bindinput="onFieldChange" placeholder="例如：30（填大概数字即可）" />
        </view>

        <view class="field">
          <view class="label">保障类保险</view>
          <textarea class="textarea" value="{{formData.protectionInsurance}}" data-key="protectionInsurance" bindinput="onFieldChange" placeholder="例如：百万医疗/年交500元；重疾险50万/年交8000元 / 无" auto-height maxlength="300" />
        </view>

        <view class="field">
          <view class="label">触发场景<text class="required">*</text></view>
          <picker mode="selector" range='{{["客户主动咨询（有明确原话）", "非主动咨询（代理人通过社交激活话题）"]}}' data-key="triggerScenario" bindchange="onSelectChange">
            <view class="picker-display">
              <text class="{{formData.triggerScenario ? '' : 'picker-placeholder'}}">{{formData.triggerScenario || '请选择'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>

        <view class="field">
          <view class="label">客户原话或背景描述<text class="required">*</text></view>
          <textarea class="textarea" value="{{formData.clientOriginalWords}}" data-key="clientOriginalWords" bindinput="onFieldChange" placeholder="例如：我想买个保险，你帮我看看 / 聊到孩子教育，客户说想送孩子出国读书" auto-height maxlength="500" />
        </view>

        <view class="field">
          <view class="label">客户异议/卡点</view>
          <textarea class="textarea" value="{{formData.clientObjection}}" data-key="clientObjection" bindinput="onFieldChange" placeholder="例如：客户说你们产品收益不如基金 / 我要跟家人商量一下" auto-height maxlength="500" />
        </view>

      </view>

      <view class="step-nav">
        <view></view>
        <button class="btn-primary submit-btn" bindtap="submitForm" disabled="{{isLoading || voiceParsingKyc}}" loading="{{isLoading}}">
          {{isLoading ? '教练诊断中...' : '提交给保险教练快速诊断'}}
        </button>
      </view>
    </view>

    <!-- ====== 完整模式表单（原有 6 步） ====== -->
    <block wx:if="{{!quickMode}}">
    <!-- 步骤进度条 -->
    <view class="step-progress">
      <block wx:for="{{sortedSections}}" wx:key="title" wx:for-index="index">
        <view class="step-dot {{index <= currentStep ? 'done' : ''}} {{index === currentStep ? 'current' : ''}}">
          <text class="step-num">{{index < currentStep ? '✓' : index + 1}}</text>
        </view>
        <view class="step-line {{index < currentStep ? 'done' : ''}}" wx:if="{{index < sortedSections.length - 1}}"></view>
      </block>
    </view>
    <view class="step-label">{{sortedSections[currentStep].title}}（{{currentStep + 1}}/{{sortedSections.length}}）</view>

    <!-- 当前步骤字段 -->
    <view class="section">
      <view class="section-body">

        <!-- 推荐填写字段 -->
        <view class="field" wx:for="{{sortedSections[currentStep].recommended}}" wx:key="key" wx:for-item="f">
          <view class="label">
            {{f.label}}<text wx:if="{{f.required}}" class="required">*</text>
            <text class="tag recommended-tag">建议填写</text>
          </view>

          <!-- radio -->
          <block wx:if="{{f.type === 'radio'}}">
            <view class="radio-group">
              <view
                class="radio-item {{formData[f.key] === opt ? 'checked' : ''}}"
                wx:for="{{f.options}}"
                wx:key="*this"
                wx:for-item="opt"
                data-key="{{f.key}}"
                data-val="{{opt}}"
                bindtap="onFieldChange"
              >
                <text>{{opt === 'male' ? '男' : opt === 'female' ? '女' : opt}}</text>
              </view>
            </view>
          </block>

          <!-- select / picker -->
          <block wx:elif="{{f.type === 'select'}}">
            <picker mode="selector" range="{{f.options}}" data-key="{{f.key}}" bindchange="onSelectChange">
              <view class="picker-display">
                <text class="{{formData[f.key] ? '' : 'picker-placeholder'}}">{{formData[f.key] || '请选择'}}</text>
                <text class="picker-arrow">▼</text>
              </view>
            </picker>
          </block>

          <!-- textarea -->
          <block wx:elif="{{f.type === 'textarea'}}">
            <textarea class="textarea" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" auto-height maxlength="500" />
          </block>

          <!-- number -->
          <block wx:elif="{{f.type === 'number'}}">
            <input class="input" type="number" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />
          </block>

          <!-- text default -->
          <block wx:else>
            <input class="input" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />
          </block>
        </view>

        <!-- 可选字段区域 -->
        <block wx:if="{{sortedSections[currentStep].hasOptional}}">
          <!-- 前3个步骤（index 0-2）可选字段可折叠 -->
          <block wx:if="{{currentStep <= 2}}">
            <button class="expand-toggle" data-step="{{currentStep}}" bindtap="toggleExpand">
              <text>{{expandedSections[currentStep] ? '收起 ▲' : '展开更多细节 ▼'}}</text>
            </button>
            <view class="optional-fields {{expandedSections[currentStep] ? 'expanded' : 'collapsed'}}">
              <view class="field" wx:for="{{sortedSections[currentStep].optional}}" wx:key="key" wx:for-item="f">
                <view class="label">
                  {{f.label}}
                  <text class="tag optional-tag">可选</text>
                </view>

                <block wx:if="{{f.type === 'select'}}">
                  <picker mode="selector" range="{{f.options}}" data-key="{{f.key}}" bindchange="onSelectChange">
                    <view class="picker-display">
                      <text class="{{formData[f.key] ? '' : 'picker-placeholder'}}">{{formData[f.key] || '请选择'}}</text>
                      <text class="picker-arrow">▼</text>
                    </view>
                  </picker>
                </block>

                <block wx:elif="{{f.type === 'textarea'}}">
                  <textarea class="textarea" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" auto-height maxlength="500" />
                </block>

                <block wx:elif="{{f.type === 'number'}}">
                  <input class="input" type="number" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />
                </block>

                <block wx:else>
                  <input class="input" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />
                </block>
              </view>
            </view>
          </block>

          <!-- 后3个步骤（index 3-5）直接展开可选字段 -->
          <block wx:else>
            <view class="optional-divider"></view>
            <view class="field" wx:for="{{sortedSections[currentStep].optional}}" wx:key="key" wx:for-item="f">
              <view class="label">
                {{f.label}}
                <text class="tag optional-tag">可选</text>
              </view>

              <block wx:if="{{f.type === 'select'}}">
                <picker mode="selector" range="{{f.options}}" data-key="{{f.key}}" bindchange="onSelectChange">
                  <view class="picker-display">
                    <text class="{{formData[f.key] ? '' : 'picker-placeholder'}}">{{formData[f.key] || '请选择'}}</text>
                    <text class="picker-arrow">▼</text>
                  </view>
                </picker>
              </block>

              <block wx:elif="{{f.type === 'textarea'}}">
                <textarea class="textarea" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" auto-height maxlength="500" />
              </block>

              <block wx:elif="{{f.type === 'number'}}">
                <input class="input" type="number" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />
              </block>

              <block wx:else>
                <input class="input" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />
              </block>
            </view>
          </block>
        </block>
      </view>
    </view>

    <!-- 步骤导航按钮 -->
    <view class="step-nav">
      <button class="btn-outline" wx:if="{{currentStep > 0}}" bindtap="prevStep">← 上一步</button>
      <view wx:else></view>
      <button class="btn-primary" wx:if="{{currentStep < sortedSections.length - 1}}" bindtap="nextStep">下一步 →</button>
      <button class="btn-primary submit-btn" wx:else bindtap="submitForm" disabled="{{isLoading || voiceParsingKyc}}" loading="{{isLoading}}">
        {{isLoading ? '教练诊断中...' : '提交给保险教练诊断'}}
      </button>
    </view>
    </block>
  </view>

  <!-- 教练对话区 -->
  <view class="chat-area" wx:if="{{tab === 'coach'}}">
    <scroll-view scroll-y class="chat-scroll" scroll-into-view="{{scrollIntoView}}" enhanced show-scrollbar="{{false}}" bindscroll="onChatScroll" style="height: {{chatScrollHeight}}px;">
      <view class="empty-chat" wx:if="{{!hasSubmitted}}">
        <text class="empty-icon">🧑‍🏫</text>
        <text class="empty-title">AI 保险教练已就绪</text>
        <text class="empty-desc">填写客户 KYC 信息后提交，教练将为你生成</text>
        <view class="empty-features">
          <text class="ef-item">✅ 卡点诊断</text>
          <text class="ef-item">✅ 推演方向</text>
          <text class="ef-item">✅ 建议话术</text>
        </view>
        <text class="empty-hint">切换到「信息填写」开始吧 →</text>
      </view>

      <view class="msg-list" wx:else>
        <view class="msg-item" wx:for="{{messages}}" wx:key="timestamp" id="msg-{{index}}">
          <view class="msg-user {{item.role === 'user' ? 'right' : 'left'}}">
            <view class="msg-role">{{item.role === 'user' ? '代理人' : 'AI 教练'}}</view>
            <view class="msg-bubble {{item.role === 'user' ? 'user-bubble' : 'coach-bubble'}}">
              <text class="msg-text" wx:if="{{item.role === 'user' || (item.streaming && item.content)}}" selectable>{{item.content}}</text>
              <block wx:elif="{{item.streaming && !item.content}}">
                <text class="loading-stage">{{loadingText}}</text>
                <view class="typing-dots">
                  <view class="dot"></view><view class="dot"></view><view class="dot"></view>
                </view>
              </block>
              <rich-text wx:else nodes="{{item.contentHtml || item.content}}" class="msg-rich"></rich-text>
              <view wx:if="{{item.role === 'coach' && !item.streaming}}" class="feedback-row">
                <view class="copy-btn" data-idx="{{index}}" catchtap="copyCoachMsg">复制</view>
                <view class="fb-btn {{item.feedback === 'helpful' ? 'fb-active' : ''}}" data-idx="{{index}}" data-rating="helpful" catchtap="onFeedback">{{item.feedback === 'helpful' ? '已赞' : '有帮助'}}</view>
                <view class="fb-btn {{item.feedback === 'unhelpful' ? 'fb-active' : ''}}" data-idx="{{index}}" data-rating="unhelpful" catchtap="onFeedback">{{item.feedback === 'unhelpful' ? '已反馈' : '不准确'}}</view>
              </view>
            </view>
          </view>
        </view>

      </view>
    </scroll-view>

    <!-- 滚到底部按钮 -->
    <view class="scroll-bottom-btn {{scrollToBottom ? 'show' : ''}}" bindtap="scrollChatToBottom">
      <text class="scroll-bottom-arrow">↓</text>
    </view>

    <!-- 积分消耗提示 -->
    <view class="point-cost-tip" wx:if="{{lastPointCost != null && !isLoading}}">
      <text class="point-cost-text">本次消耗 {{lastPointCost}} 积分</text>
    </view>

    <!-- 追问输入区 -->
    <view class="chat-input" wx:if="{{hasSubmitted}}">
      <input class="follow-input" value="{{followUp}}" bindinput="onFollowUpInput" placeholder="输入追问内容..." confirm-type="send" bindconfirm="sendFollowUp" disabled="{{isLoading}}" />
      <button class="btn-primary send-btn" bindtap="sendFollowUp" disabled="{{!followUp || isLoading}}">发送</button>
    </view>
  </view>

  <!-- 语音录制浮层 -->
  <view class="voice-overlay" wx:if="{{recording}}">
    <view class="voice-overlay-mask" bindtap="cancelVoiceInput"></view>
    <view class="voice-overlay-content">
      <view class="voice-wave">
        <view class="voice-wave-bar"></view>
        <view class="voice-wave-bar"></view>
        <view class="voice-wave-bar"></view>
        <view class="voice-wave-bar"></view>
        <view class="voice-wave-bar"></view>
      </view>
      <view class="voice-text" wx:if="{{voiceText}}">{{voiceText}}</view>
      <view class="voice-text voice-placeholder" wx:else>正在倾听...</view>
      <view class="voice-actions">
        <button class="voice-btn voice-btn-cancel" bindtap="cancelVoiceInput">取消</button>
        <button class="voice-btn voice-btn-done" bindtap="stopVoiceInput">说完啦</button>
      </view>
    </view>
  </view>

  <!-- AI 解析中 -->
  <view class="voice-parsing-overlay" wx:if="{{voiceParsingKyc}}">
    <view class="voice-parsing-mask"></view>
    <view class="voice-parsing-toast">
      <text>🤖 AI 正在解析中...</text>
    </view>
  </view>

  <!-- 新用户引导弹窗 -->
  <view class="guide-overlay" wx:if="{{showGuide}}" bindtap="dismissGuide">
    <view class="guide-modal" catchtap="">
      <view class="guide-title">🎯 三步开始</view>
      <view class="guide-steps">
        <view class="guide-step">
          <view class="guide-step-num">1</view>
          <view class="guide-step-text">
            <view class="guide-step-title">新建客户</view>
            <view class="guide-step-desc">点击顶部「+ 新建客户」，录入面谈对象的基本信息</view>
          </view>
        </view>
        <view class="guide-step">
          <view class="guide-step-num">2</view>
          <view class="guide-step-text">
            <view class="guide-step-title">填写面谈信息</view>
            <view class="guide-step-desc">按步骤填写客户画像、职业收入、资产、保障和面谈卡点</view>
          </view>
        </view>
        <view class="guide-step">
          <view class="guide-step-num">3</view>
          <view class="guide-step-text">
            <view class="guide-step-title">AI 诊断</view>
            <view class="guide-step-desc">提交后 AI 教练会给出卡点诊断、推演方向和话术建议</view>
          </view>
        </view>
      </view>
      <button class="guide-btn" bindtap="dismissGuide">开始使用</button>
    </view>
  </view>

</view>
