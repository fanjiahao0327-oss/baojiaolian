<!-- 教练页 -->
<view class="page">

  <!-- 授权覆盖层（登录或绑定手机号） -->
  <view class="auth-overlay" wx:if="{{!isLoggedIn || needBindPhone}}">
    <view class="auth-card">
      <text class="auth-icon">🛡️</text>
      <text class="auth-title">领展智教练</text>
      <text class="auth-desc" wx:if="{{!isLoggedIn}}">AI 驱动的保险销售教练</text>
      <text class="auth-desc" wx:else>为保障服务安全，请授权绑定手机号</text>

      <!-- 未登录 → 微信一键登录 -->
      <button wx:if="{{!isLoggedIn}}" class="auth-btn" bindtap="handleWechatLogin" loading="{{logining}}" disabled="{{logining}}">
        微信一键登录
      </button>

      <!-- 已登录、未绑定 → 授权手机号 -->
      <button wx:else class="auth-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
        授权手机号
      </button>
    </view>
  </view>

  <!-- 正常页面内容 -->
  <block wx:if="{{isLoggedIn && !needBindPhone}}">
  <!-- 顶部 Tab + 客户选择 -->
  <view class="top-bar">
    <view class="tabs">
      <view class="tab-item {{tab === 'form' ? 'active' : ''}}" data-tab="form" bindtap="switchTab">信息填写</view>
      <view class="tab-item {{tab === 'coach' ? 'active' : ''}}" data-tab="coach" bindtap="switchTab">教练指导</view>
    </view>
    <view class="top-right">
      <view class="balance-tag" wx:if="{{balance >= 0}}">
        <text class="balance-dot"></text>
        <text>{{balance}} 积分</text>
      </view>
      <view class="client-picker-btn" bindtap="toggleClientPicker">
        <text>{{selectedClientId ? '已选客户' : '选择客户'}}</text>
        <text class="arrow">▾</text>
      </view>
    </view>
  </view>

  <!-- 客户选择弹出层 -->
  <view class="picker-overlay" wx:if="{{showClientPicker}}" bindtap="toggleClientPicker"></view>
  <view class="picker-popup {{showClientPicker ? 'show' : ''}}">
    <view class="picker-title">选择客户</view>
    <view class="picker-option" data-id="" bindtap="selectClient">+ 新建客户</view>
    <view class="picker-option" wx:for="{{clients}}" wx:key="id" data-id="{{item.id}}" bindtap="selectClient">{{item.name}}</view>
  </view>

  <!-- KYC 步骤式表单 -->
  <view class="form-area" wx:if="{{tab === 'form'}}">
    <!-- 步骤进度条 -->
    <view class="step-progress">
      <block wx:for="{{sortedSections}}" wx:key="title" wx:for-index="index">
        <view class="step-dot {{index <= currentStep ? 'done' : ''}} {{index === currentStep ? 'current' : ''}}">
          <text class="step-num">{{index < currentStep ? '✓' : index + 1}}</text>
        </view>
        <view class="step-line {{index < currentStep ? 'done' : ''}}" wx:if="{{index < sortedSections.length - 1}}"></view>
      </block>
    </view>
    <view class="step-label">{{sortedSections[currentStep].title}}（{{currentStep + 1}}/{{sortedSections.length}}）</view>

    <!-- 当前步骤字段 -->
    <view class="section">
      <view class="section-body">

        <!-- 推荐填写字段 -->
        <view class="field" wx:for="{{sortedSections[currentStep].recommended}}" wx:key="key" wx:for-item="f">
          <view class="label">
            {{f.label}}<text wx:if="{{f.required}}" class="required">*</text>
            <text class="tag recommended-tag">建议填写</text>
          </view>

          <!-- radio -->
          <view class="radio-group" wx:if="{{f.type === 'radio'}}">
            <view
              class="radio-item {{formData[f.key] === opt ? 'checked' : ''}}"
              wx:for="{{f.options}}"
              wx:key="*this"
              wx:for-item="opt"
              data-key="{{f.key}}"
              data-val="{{opt}}"
              bindtap="onFieldChange"
            >
              <text>{{opt === 'male' ? '男' : opt === 'female' ? '女' : opt}}</text>
            </view>
          </view>

          <!-- select / picker -->
          <picker wx:elif="{{f.type === 'select'}}" mode="selector" range="{{f.options}}" data-key="{{f.key}}" bindchange="onSelectChange">
            <view class="picker-display">
              <text class="{{formData[f.key] ? '' : 'picker-placeholder'}}">{{formData[f.key] || '请选择'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>

          <!-- checkbox-group -->
          <view class="checkbox-list" wx:elif="{{f.type === 'checkbox-group'}}">
            <view
              class="checkbox-item {{formData[f.key].indexOf(opt) >= 0 ? 'checked' : ''}}"
              wx:for="{{f.options}}"
              wx:key="*this"
              wx:for-item="opt"
              data-key="{{f.key}}"
              data-val="{{opt}}"
              bindtap="onCheckboxToggle"
            >
              <text class="checkbox-icon">{{formData[f.key].indexOf(opt) >= 0 ? '☑' : '☐'}}</text>
              <text>{{opt}}</text>
            </view>
            <!-- "其他"输入框 -->
            <input
              wx:if="{{f.key === 'incomeSources' && formData.incomeSources.indexOf('其他') >= 0}}"
              class="input checkbox-other-input"
              value="{{formData.incomeSourcesOther}}"
              data-key="incomeSourcesOther"
              bindinput="onFieldChange"
              placeholder="请说明其他收入来源"
            />
          </view>

          <!-- textarea -->
          <textarea wx:elif="{{f.type === 'textarea'}}" class="textarea" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" auto-height maxlength="500" />

          <!-- number -->
          <input wx:elif="{{f.type === 'number'}}" class="input" type="number" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />

          <!-- text default -->
          <input wx:else class="input" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />
        </view>

        <!-- 可选字段区域 -->
        <block wx:if="{{sortedSections[currentStep].hasOptional}}">
          <!-- 前3个步骤（index 0-2）可选字段可折叠 -->
          <block wx:if="{{currentStep <= 2}}">
            <button class="expand-toggle" data-step="{{currentStep}}" bindtap="toggleExpand">
              <text>{{expandedSections[currentStep] ? '收起 ▲' : '展开更多细节 ▼'}}</text>
            </button>
            <view class="optional-fields {{expandedSections[currentStep] ? 'expanded' : 'collapsed'}}">
              <view class="field" wx:for="{{sortedSections[currentStep].optional}}" wx:key="key" wx:for-item="f">
                <view class="label">
                  {{f.label}}
                  <text class="tag optional-tag">可选</text>
                </view>

                <picker wx:if="{{f.type === 'select'}}" mode="selector" range="{{f.options}}" data-key="{{f.key}}" bindchange="onSelectChange">
                  <view class="picker-display">
                    <text class="{{formData[f.key] ? '' : 'picker-placeholder'}}">{{formData[f.key] || '请选择'}}</text>
                    <text class="picker-arrow">▼</text>
                  </view>
                </picker>

                <textarea wx:elif="{{f.type === 'textarea'}}" class="textarea" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" auto-height maxlength="500" />

                <input wx:elif="{{f.type === 'number'}}" class="input" type="number" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />

                <input wx:else class="input" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />
              </view>
            </view>
          </block>

          <!-- 后3个步骤（index 3-5）直接展开可选字段 -->
          <block wx:else>
            <view class="optional-divider"></view>
            <view class="field" wx:for="{{sortedSections[currentStep].optional}}" wx:key="key" wx:for-item="f">
              <view class="label">
                {{f.label}}
                <text class="tag optional-tag">可选</text>
              </view>

              <picker wx:if="{{f.type === 'select'}}" mode="selector" range="{{f.options}}" data-key="{{f.key}}" bindchange="onSelectChange">
                <view class="picker-display">
                  <text class="{{formData[f.key] ? '' : 'picker-placeholder'}}">{{formData[f.key] || '请选择'}}</text>
                  <text class="picker-arrow">▼</text>
                </view>
              </picker>

              <textarea wx:elif="{{f.type === 'textarea'}}" class="textarea" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" auto-height maxlength="500" />

              <input wx:elif="{{f.type === 'number'}}" class="input" type="number" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />

              <input wx:else class="input" value="{{formData[f.key]}}" data-key="{{f.key}}" bindinput="onFieldChange" placeholder="{{f.placeholder || '请输入'}}" />
            </view>
          </block>
        </block>
      </view>
    </view>

    <!-- 步骤导航按钮 -->
    <view class="step-nav">
      <button class="btn-outline" wx:if="{{currentStep > 0}}" bindtap="prevStep">← 上一步</button>
      <view wx:else></view>
      <button class="btn-primary" wx:if="{{currentStep < sortedSections.length - 1}}" bindtap="nextStep">下一步 →</button>
      <button class="btn-primary submit-btn" wx:else bindtap="submitForm" disabled="{{isLoading}}" loading="{{isLoading}}">
        {{isLoading ? '教练诊断中...' : '提交给保险教练诊断'}}
      </button>
    </view>
  </view>

  <!-- 教练对话区 -->
  <view class="chat-area" wx:if="{{tab === 'coach'}}">
    <scroll-view scroll-y class="chat-scroll" scroll-into-view="{{scrollIntoView}}" enhanced show-scrollbar="{{false}}" bindscroll="onChatScroll" style="height: {{chatScrollHeight}}px;">
      <view class="empty-chat" wx:if="{{!hasSubmitted}}">
        <text class="empty-icon">🧑‍🏫</text>
        <text class="empty-title">AI 保险教练已就绪</text>
        <text class="empty-desc">填写客户 KYC 信息后提交，教练将为你生成</text>
        <view class="empty-features">
          <text class="ef-item">✅ 卡点诊断</text>
          <text class="ef-item">✅ 推演方向</text>
          <text class="ef-item">✅ 建议话术</text>
        </view>
        <text class="empty-hint">切换到「信息填写」开始吧 →</text>
      </view>

      <view class="msg-list" wx:else>
        <view class="msg-item" wx:for="{{messages}}" wx:key="timestamp" id="msg-{{index}}">
          <view class="msg-user {{item.role === 'user' ? 'right' : 'left'}}">
            <view class="msg-role">{{item.role === 'user' ? '代理人' : 'AI 教练'}}</view>
            <view class="msg-bubble {{item.role === 'user' ? 'user-bubble' : 'coach-bubble'}}">
              <text class="msg-text" wx:if="{{item.role === 'user'}}" selectable>{{item.content}}</text>
              <rich-text wx:else nodes="{{item.content}}" class="msg-rich"></rich-text>
              <view wx:if="{{item.role === 'coach'}}" class="copy-btn" data-idx="{{index}}" catchtap="copyCoachMsg">复制</view>
            </view>
          </view>
        </view>

        <!-- 加载中 -->
        <view class="msg-item" wx:if="{{isLoading}}">
          <view class="msg-user left">
            <view class="msg-role">AI 教练</view>
            <view class="msg-bubble coach-bubble">
              <text class="loading-stage">{{loadingText}}</text>
              <view class="typing-dots">
                <view class="dot"></view><view class="dot"></view><view class="dot"></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 滚到底部按钮 -->
    <view class="scroll-bottom-btn {{scrollToBottom ? 'show' : ''}}" bindtap="scrollChatToBottom">
      <text class="scroll-bottom-arrow">↓</text>
    </view>

    <!-- 追问输入区 -->
    <view class="chat-input" wx:if="{{hasSubmitted}}">
      <input class="follow-input" value="{{followUp}}" bindinput="onFollowUpInput" placeholder="输入追问内容..." confirm-type="send" bindconfirm="sendFollowUp" disabled="{{isLoading}}" />
      <button class="btn-primary send-btn" bindtap="sendFollowUp" disabled="{{!followUp || isLoading}}">发送</button>
    </view>
  </view>

  </block>
</view>
