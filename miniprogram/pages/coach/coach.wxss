/* === 手机号绑定横幅（非阻塞） === */
.phone-bind-banner {
  background: #fff7ed;
  border-bottom: 1px solid #fed7aa;
}
.banner-content {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}
.banner-icon { font-size: 28rpx; }
.banner-text {
  flex: 1;
  font-size: 24rpx;
  color: #c2410c;
}
.banner-bind-btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  background: #f97316;
  color: #fff;
  border-radius: 20rpx;
  border: none;
  line-height: 1.4;
}
.banner-close {
  font-size: 28rpx;
  color: #999;
  padding: 4rpx 8rpx;
}

/* === 顶部栏登录入口按钮 === */
.login-entry-btn {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  background: linear-gradient(135deg, #1a56db, #2563eb);
  color: #fff;
  border-radius: 20rpx;
  border: none;
  line-height: 1.4;
  display: flex;
  align-items: center;
}
.login-entry-btn[disabled] { opacity: 0.6; }

/* === 快速模式切换 === */
.quick-mode-toggle {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 1px solid #f0f0f0;
}
.qmt-track {
  width: 80rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #ddd;
  display: flex;
  align-items: center;
  padding: 4rpx;
  transition: background 0.2s;
}
.qmt-track.active {
  background: #1a56db;
}
.qmt-thumb {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
  transition: transform 0.2s;
}
.qmt-track.active .qmt-thumb {
  transform: translateX(36rpx);
}
.qmt-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.qmt-desc {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 页面原生滚动 */
.page {
  min-height: 100vh;
}

/* 顶栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1px solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tabs { display: flex; gap: 32rpx; }
.tab-item {
  font-size: 28rpx;
  color: #999;
  padding-bottom: 12rpx;
  position: relative;
}
.tab-item.active { color: #1a56db; font-weight: 600; }
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0; left: 20%; right: 20%;
  height: 4rpx;
  background: #1a56db;
  border-radius: 2rpx;
}
.client-picker-btn {
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 20rpx; background: #f0f0f0;
  border-radius: 20rpx; font-size: 24rpx; color: #666;
}
.arrow { font-size: 20rpx; }
.top-right { display: flex; align-items: center; gap: 12rpx; }
.balance-tag {
  display: flex; align-items: center; gap: 6rpx;
  padding: 8rpx 16rpx;
  background: #f0f5ff;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #1a56db;
  font-weight: 500;
  white-space: nowrap;
}
.balance-dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: #10b981;
}

/* 客户选择层 */
.picker-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3); z-index: 100;
}
.picker-popup {
  position: fixed; bottom: -600rpx; left: 0; right: 0;
  background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx; z-index: 101;
  transition: bottom 0.3s; max-height: 70vh; overflow-y: auto;
}
.picker-popup.show { bottom: 0; }
.picker-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.picker-option { padding: 20rpx 0; border-bottom: 1px solid #f0f0f0; font-size: 28rpx; }

/* === 表单区域 === */
.form-area {
  padding: 24rpx 0;
  padding-bottom: 60rpx;
}

/* 步骤进度条 */
.step-progress {
  display: flex; align-items: center; justify-content: center;
  padding: 0 20rpx; margin-bottom: 12rpx;
}
.step-dot {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: #e5e7eb;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: background 0.3s;
}
.step-dot.done { background: #10b981; }
.step-dot.current { background: #1a56db; box-shadow: 0 0 0 4rpx rgba(26,86,219,0.2); }
.step-num {
  font-size: 22rpx; font-weight: 600; color: #fff;
}
.step-line {
  flex: 1; height: 3rpx; background: #e5e7eb;
  margin: 0 4rpx; border-radius: 2rpx;
}
.step-line.done { background: #10b981; }
.step-label {
  text-align: center; font-size: 28rpx; font-weight: 600;
  color: #333; margin-bottom: 20rpx;
}

/* 字段区域 */
.section {
  background: #fff; border-radius: 16rpx; overflow: hidden;
}
.section-body { padding: 20rpx 12rpx; }
.field { margin-bottom: 24rpx; }
.field:last-child { margin-bottom: 0; }
.label { font-size: 28rpx; color: #555; margin-bottom: 12rpx; display: block; }
.required { color: #ef4444; }

/* 优先级标签 */
.tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 20rpx;
  font-weight: 400;
  vertical-align: middle;
}
.recommended-tag {
  background: #e8f0fe;
  color: #1a56db;
}
.optional-tag {
  background: #f0f0f0;
  color: #aaa;
}

/* 基础输入 */
.input {
  width: 100%; height: 80rpx; line-height: 80rpx;
  padding: 0 16rpx;
  border: 1px solid #ddd; border-radius: 10rpx;
  font-size: 30rpx; box-sizing: border-box;
  background: #fafafa;
}
.textarea {
  width: 100%; padding: 20rpx 16rpx;
  border: 1px solid #ddd; border-radius: 10rpx;
  font-size: 30rpx; box-sizing: border-box;
  background: #fafafa;
  min-height: 120rpx;
}

.radio-group { display: flex; flex-wrap: wrap; gap: 16rpx; }
.radio-item {
  padding: 14rpx 28rpx; border: 1px solid #ddd;
  border-radius: 12rpx; font-size: 26rpx; color: #666;
}
.radio-item.checked {
  border-color: #1a56db; background: #e8f0fe; color: #1a56db;
}

/* === Picker 下拉选择 === */
.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%; height: 80rpx;
  padding: 0 16rpx;
  border: 1px solid #ddd;
  border-radius: 10rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #fafafa;
}
.picker-placeholder {
  color: #999;
}
.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

/* === Checkbox 多选组 === */
.checkbox-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.checkbox-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border: 1px solid #ddd;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
}
.checkbox-item.checked {
  border-color: #1a56db;
  background: #e8f0fe;
  color: #1a56db;
}
.checkbox-icon {
  font-size: 28rpx;
}
.checkbox-other-input {
  margin-top: 12rpx;
}

/* === 折叠/展开 === */
.expand-toggle {
  width: 100%;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #aaa;
  background: transparent;
  border: none;
  text-align: center;
  line-height: 1;
}
.expand-toggle::after {
  border: none;
}

.optional-fields {
  overflow: hidden;
  transition: max-height 0.3s, opacity 0.3s;
}
.optional-fields.collapsed {
  max-height: 0;
  opacity: 0;
}
.optional-fields.expanded {
  max-height: 4000rpx;
  opacity: 1;
}
.optional-fields .field {
  margin-top: 24rpx;
}

.optional-divider {
  border-top: 1px solid #eee;
  margin: 20rpx 0;
}

/* 步骤导航按钮 */
.step-nav {
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx 0;
}
.step-nav .btn-outline {
  padding: 18rpx 36rpx; font-size: 28rpx;
}
.step-nav .btn-primary {
  padding: 18rpx 48rpx; font-size: 28rpx;
}
.submit-btn { width: 100%; text-align: center; }

/* === 对话区 === */
.chat-area {
  display: flex; flex-direction: column;
  height: auto;
  position: relative;
}
.chat-scroll {
  padding: 16rpx; background: #f5f5f5;
}

.empty-chat {
  display: flex; flex-direction: column; align-items: center;
  padding: 80rpx 40rpx; color: #999; font-size: 28rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #999; margin-bottom: 20rpx; }
.empty-features { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 24rpx; }
.ef-item { font-size: 26rpx; color: #555; }
.empty-hint { font-size: 24rpx; color: #1a56db; margin-top: 12rpx; }
.sub-text { font-size: 24rpx; color: #ccc; margin-top: 12rpx; }

/* 消息 */
.msg-list { padding-bottom: 20rpx; }
.msg-item { margin-bottom: 24rpx; }
.msg-user { display: flex; flex-direction: column; }
.msg-user.right { align-items: flex-end; }
.msg-user.left { align-items: flex-start; }
.msg-role { font-size: 22rpx; color: #999; margin-bottom: 8rpx; }

.msg-bubble {
  max-width: 85%; padding: 20rpx 24rpx;
  border-radius: 20rpx; font-size: 28rpx; line-height: 1.6;
}
.user-bubble { background: #e8f0fe; color: #333; border-top-right-radius: 6rpx; }
.coach-bubble { background: #fff; border: 1px solid #eee; border-top-left-radius: 6rpx; }
.msg-text { white-space: pre-wrap; word-break: break-all; }

/* 教练输出富文本排版 */
.msg-rich {
  line-height: 1.8;
  font-size: 28rpx;
  color: #333;
}
/* rich-text 内部不支持 class 选择器，通过标签选择器需要在全局定义，此处用外层 .msg-rich 作为容器 */


/* 反馈按钮行 */
.feedback-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1px solid #f0f0f0;
}
.copy-btn {
  font-size: 22rpx;
  color: #1a56db;
  opacity: 0.6;
}
.fb-btn {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
}
.fb-btn.fb-active {
  color: #1a56db;
  background: #e8f0ff;
}

/* 加载动画 */
.typing-dots { display: flex; gap: 12rpx; padding: 10rpx 0; }
.dot {
  width: 14rpx; height: 14rpx;
  background: #1a56db; border-radius: 50%;
  animation: dotPulse 1.4s infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}
.loading-stage {
  font-size: 24rpx;
  color: #1a56db;
  display: block;
  margin-bottom: 8rpx;
}

/* 滚到底部按钮 */
.scroll-bottom-btn {
  position: absolute;
  right: 28rpx;
  bottom: 100rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1a56db;
  box-shadow: 0 4rpx 16rpx rgba(26, 86, 219, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 0.25s, transform 0.25s;
  pointer-events: none;
  z-index: 5;
}
.scroll-bottom-btn.show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}
.scroll-bottom-arrow {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

/* 追问输入 */
.chat-input {
  display: flex; gap: 16rpx; padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1px solid #eee;
}
.follow-input {
  flex: 1; padding: 18rpx 20rpx;
  border: 1px solid #eee; border-radius: 20rpx; font-size: 28rpx;
}
.send-btn { padding: 14rpx 32rpx; border-radius: 20rpx; font-size: 26rpx; flex-shrink: 0; }

/* 积分消耗提示 */
.point-cost-tip {
  text-align: center; padding: 10rpx 0;
}
.point-cost-text {
  font-size: 24rpx; color: #999;
}

/* 新用户引导弹窗 */
.guide-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}
.guide-modal {
  background: #fff; border-radius: 24rpx; padding: 40rpx 36rpx;
  width: 600rpx; box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.12);
}
.guide-title {
  font-size: 36rpx; font-weight: 700; color: #1a293b;
  text-align: center; margin-bottom: 32rpx;
}
.guide-steps {
  margin-bottom: 32rpx;
}
.guide-step {
  display: flex; align-items: flex-start; margin-bottom: 24rpx;
}
.guide-step-num {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #1a56db; color: #fff; font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 16rpx;
}
.guide-step-title {
  font-size: 28rpx; font-weight: 600; color: #1a293b; margin-bottom: 4rpx;
}
.guide-step-desc {
  font-size: 24rpx; color: #888; line-height: 1.6;
}
.guide-btn {
  width: 100%; height: 80rpx; line-height: 80rpx;
  background: #1a56db; color: #fff; font-size: 30rpx; font-weight: 600;
  border-radius: 40rpx; text-align: center;
}

/* 语音录入入口 */
.voice-entry {
  display: flex; align-items: center; gap: 16rpx;
  margin: 16rpx 0; padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border-radius: 16rpx; border: 2rpx dashed #1a56db;
}
.voice-icon { font-size: 40rpx; }
.voice-label { font-size: 28rpx; font-weight: 600; color: #1a56db; }
.voice-hint { font-size: 24rpx; color: #6b7280; margin-left: auto; }

/* 语音录制浮层 */
.voice-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000; }
.voice-overlay-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); }
.voice-overlay-content {
  position: absolute; bottom: 80rpx; left: 40rpx; right: 40rpx;
  background: #fff; border-radius: 32rpx; padding: 48rpx 36rpx 36rpx;
  display: flex; flex-direction: column; align-items: center;
}

/* 声波动画 */
.voice-wave { display: flex; align-items: flex-end; gap: 8rpx; height: 80rpx; margin-bottom: 32rpx; }
.voice-wave-bar {
  width: 8rpx; background: #1a56db; border-radius: 4rpx;
  animation: wave 0.8s ease-in-out infinite;
}
.voice-wave-bar:nth-child(1) { height: 24rpx; animation-delay: 0s; }
.voice-wave-bar:nth-child(2) { height: 48rpx; animation-delay: 0.1s; }
.voice-wave-bar:nth-child(3) { height: 72rpx; animation-delay: 0.2s; }
.voice-wave-bar:nth-child(4) { height: 48rpx; animation-delay: 0.3s; }
.voice-wave-bar:nth-child(5) { height: 24rpx; animation-delay: 0.4s; }
@keyframes wave {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(0.4); }
}

.voice-text { font-size: 28rpx; color: #333; text-align: center; line-height: 1.6; max-height: 200rpx; overflow-y: auto; margin-bottom: 32rpx; width: 100%; }
.voice-placeholder { color: #999; }
.voice-actions { display: flex; gap: 24rpx; width: 100%; }
.voice-btn { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; font-size: 28rpx; font-weight: 600; }
.voice-btn-cancel { background: #f3f4f6; color: #6b7280; }
.voice-btn-done { background: #1a56db; color: #fff; }

/* AI 解析中 */
.voice-parsing-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1001; display: flex; align-items: center; justify-content: center; }
.voice-parsing-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.3); }
.voice-parsing-toast {
  position: relative; background: #fff; border-radius: 16rpx; padding: 24rpx 48rpx;
  font-size: 28rpx; color: #333; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}
