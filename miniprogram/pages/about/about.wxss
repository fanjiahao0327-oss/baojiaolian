.page {
  padding: 48rpx 32rpx;
  background: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}
.title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
}
.body {
  display: block;
  margin-bottom: 16rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #374151;
}
.section {
  display: block;
  margin: 36rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}
